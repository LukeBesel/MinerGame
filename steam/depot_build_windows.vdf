// Depot config for the Windows Desktop x86_64 build. Content root matches export_presets.cfg's
// Windows export_path (builds/windows/bottleneck.exe) and build.sh/build.ps1's output layout.
"DepotBuildConfig"
{
	"DepotID"		"DEPOT_ID_WINDOWS"
	"contentroot"	"../builds/windows/"

	"FileMapping"
	{
		"LocalPath"		"*"
		"DepotPath"		"."
		"recursive"		"1"
	}

	// Debug symbols shouldn't ship; Godot's Windows export doesn't normally produce .pdb files,
	// this is a no-op safety net in case a debug template is ever used by mistake.
	"FileExclusion"	"*.pdb"
}
